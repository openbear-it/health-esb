# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
ENV GOWORK=off
WORKDIR /src

COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/simulator/go.mod apps/simulator/go.sum ./apps/simulator/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/simulator && go mod download

COPY apps/simulator/ ./apps/simulator/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -C apps/simulator -trimpath -o /bin/simulator .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/simulator /simulator
EXPOSE 8080
ENTRYPOINT ["/simulator"]
