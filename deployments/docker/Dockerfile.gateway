# syntax=docker/dockerfile:1
ARG BUILDPLATFORM
ARG TARGETOS=linux
ARG TARGETARCH=amd64
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GOWORK=off
WORKDIR /src

# Copy workspace files
COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/gateway/go.mod apps/gateway/go.sum ./apps/gateway/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/gateway && go mod download

COPY apps/gateway/ ./apps/gateway/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -C apps/gateway -trimpath -o /bin/gateway .

# ─────────────────────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/gateway /gateway
EXPOSE 8080
ENTRYPOINT ["/gateway"]
