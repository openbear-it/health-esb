# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
ENV GOWORK=off
WORKDIR /src

COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/lab-service/go.mod apps/lab-service/go.sum ./apps/lab-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/lab-service && go mod download

COPY apps/lab-service/ ./apps/lab-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -C apps/lab-service -trimpath -o /bin/lab-service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/lab-service /lab-service
EXPOSE 8080
ENTRYPOINT ["/lab-service"]
