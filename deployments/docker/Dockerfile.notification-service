# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
ENV GOWORK=off
WORKDIR /src

COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/notification-service/go.mod apps/notification-service/go.sum ./apps/notification-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/notification-service && go mod download

COPY apps/notification-service/ ./apps/notification-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -C apps/notification-service -trimpath -o /bin/notification-service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/notification-service /notification-service
EXPOSE 8080
ENTRYPOINT ["/notification-service"]
