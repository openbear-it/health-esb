# syntax=docker/dockerfile:1
ARG BUILDPLATFORM
ARG TARGETOS=linux
ARG TARGETARCH=amd64
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
WORKDIR /src

COPY go.work go.work.sum* ./
COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/audit-service/go.mod apps/audit-service/go.sum ./apps/audit-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/audit-service && go mod download

COPY apps/audit-service/ ./apps/audit-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /bin/audit-service ./apps/audit-service/...

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/audit-service /audit-service
EXPOSE 8080
ENTRYPOINT ["/audit-service"]
