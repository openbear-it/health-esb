# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
ENV GOWORK=off
WORKDIR /src

COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/audit-service/go.mod apps/audit-service/go.sum ./apps/audit-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/audit-service && go mod download

COPY apps/audit-service/ ./apps/audit-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -C apps/audit-service -trimpath -o /bin/audit-service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/audit-service /audit-service
EXPOSE 8080
ENTRYPOINT ["/audit-service"]
