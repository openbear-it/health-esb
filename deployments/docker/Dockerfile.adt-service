# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
ENV GOWORK=off
WORKDIR /src

COPY go.mod go.sum ./
COPY internal/ ./internal/

COPY apps/adt-service/go.mod apps/adt-service/go.sum ./apps/adt-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    cd apps/adt-service && go mod download

COPY apps/adt-service/ ./apps/adt-service/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -C apps/adt-service -trimpath -o /bin/adt-service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/adt-service /adt-service
EXPOSE 8080
ENTRYPOINT ["/adt-service"]
